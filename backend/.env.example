# Backend environment variables (names only — no values are kept in the repo).
# Local development: copy to .env and fill in.   On Render: service -> Environment.
# NEVER commit .env (it is in .gitignore).

# Database connection used by the running app.
#   Supabase: Project -> Connect -> Session pooler (port 5432).
#   Local Docker database: see docker-compose.yml.
DATABASE_URL=

# Database connection used by "prisma migrate". On Render use the same Session pooler string.
DIRECT_URL=

# Long random string (at least 16 characters) that signs sign-in tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# How long a sign-in lasts, e.g. 7d. Optional (default 7d).
JWT_EXPIRES_IN=

# Comma-separated browser origins allowed to call the API; "*" wildcards allowed (Vercel previews).
# Optional locally (default http://localhost:3000); required on Render.
CORS_ORIGINS=

# Port to listen on. Render sets it automatically; optional locally (default 4000).
PORT=
