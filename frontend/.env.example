# Frontend environment variables (names only — no values are kept in the repo).
# Local development: copy to .env.local and fill in.   On Vercel: Project -> Settings -> Environment Variables.
# NEXT_PUBLIC_* values are built into the page code: after changing one on Vercel, REDEPLOY.

# Address of the backend API, no trailing slash (your Render service URL; http://localhost:4000 locally).
# Required for a Vercel build; locally it falls back to http://localhost:4000.
NEXT_PUBLIC_API_URL=
